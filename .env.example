# Railway pone PORT solo. Estas son opcionales:
# Clave para ver las citas en /admin?key=TU_CLAVE
ADMIN_KEY=cambia-esta-clave
# Carpeta donde se guardan las citas. En Railway monta un Volume en /data
DATA_DIR=/data

# --- Correos de cita confirmada ---
# Al aprobarse un pago: aviso al consultorio (NOTIFY_TO) y confirmación al paciente.
# Mismos nombres que Vida Nutritiva. En Railway se usa el puente del servidor ICU
# (Railway bloquea SMTP); en tu compu se intenta SMTP directo y, si falla, el puente.

# Puente HTTPS → SMTP (proxy_smtp.php en el servidor ICU)
MAIL_PROXY_URL=https://tu-servidor.icu/proxy_smtp.php
MAIL_PROXY_SECRET=el-secreto-del-puente

# Cuenta SMTP que usa el puente (y el envío directo)
MAIL_SERVER=mail.tudominio.com
MAIL_PORT=465
MAIL_USE_SSL=True
MAIL_USERNAME=bot@tudominio.com
MAIL_PASSWORD=tu-contraseña

# Remitente visible (opcional)
MAIL_FROM="Consultorio Valeria Méndez <bot@tudominio.com>"
# A quién avisar de cada cita (varios separados por coma)
NOTIFY_TO=nutricionslim.dm@gmail.com
# MAIL_FORCE_BRIDGE=true   # usar siempre el puente, también fuera de Railway
# RESEND_API_KEY=re_xxx    # alternativa: API de Resend
