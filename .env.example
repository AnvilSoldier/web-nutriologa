# Railway pone PORT solo. Estas son opcionales:
# Clave para ver las citas en /admin?key=TU_CLAVE
ADMIN_KEY=cambia-esta-clave
# Carpeta donde se guardan las citas. En Railway monta un Volume en /data
DATA_DIR=/data

# --- Correos de cita confirmada ---
# Se manda un aviso al consultorio y otro al paciente cuando el pago se aprueba.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# SMTP_SECURE=true    (por defecto true con 465; usa false con 587)
SMTP_USER=tucorreo@gmail.com
SMTP_PASS=contraseña-de-aplicacion
MAIL_FROM="Consultorio Valeria Méndez <tucorreo@gmail.com>"
# A quién avisar de cada cita (varios separados por coma)
NOTIFY_TO=nutricionslim.dm@gmail.com
# Opcional: en Railway Hobby el SMTP está bloqueado. Con esta clave se usa la API de Resend (HTTPS).
# RESEND_API_KEY=re_xxx
